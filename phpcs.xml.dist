<?xml version="1.0"?>
<ruleset name="WordPress Plugin Coding Standards">
	<description>PHPCS configuration for Turbo Search</description>

	<!-- Scan all files in directory and subdirectories -->
	<file>.</file>

	<!-- Exclude version control, external build, minified assets and vendor directories -->
	<exclude-pattern>*/.git/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*.min.js</exclude-pattern>
	<exclude-pattern>*.min.css</exclude-pattern>

	<!-- Pass flags to PHPCS -->
	<arg value="ps"/>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>

	<!-- Check against WordPress rulesets if installed -->
	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress-Extra"/>

	<!-- Verify text domain consistency -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="turbo-search"/>
			</property>
		</properties>
	</rule>

	<!-- Minimum PHP version compatibility -->
	<config name="testVersion" value="7.4-"/>
</ruleset>

