# EditorConfig configuration for Turbo Search
# Defines coding style across editors and IDEs (VS Code, PhpStorm, Sublime, Cursor)
# Documentation: https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{js,jsx,ts,tsx}]
indent_style = space
indent_size = 4
tab_width = 4

[*.{php,phtml}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{css,scss,less}]
indent_style = space
indent_size = 4
tab_width = 4

[*.json]
indent_style = space
indent_size = 4
tab_width = 4

[*.md]
trim_trailing_whitespace = false
indent_size = 4
tab_width = 4

